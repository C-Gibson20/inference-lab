#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' 'commit-msg hook requires Git to provide one message-file path.' >&2
    exit 2
fi

repo_root=$(git rev-parse --show-toplevel)
validator="$repo_root/scripts/validate-commit-msg.sh"

if [ ! -x "$validator" ]; then
    printf '%s\n' "Commit validator is missing or not executable: $validator" >&2
    exit 2
fi

exec "$validator" --file "$1"
